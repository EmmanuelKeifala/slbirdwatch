{
  "expo": {
    "name": "SL Birdwatch",
    "slug": "slbirdwatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.slbirdwatch.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.slbirdwatch.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SL Birdwatch uses your photos so you can add bird pictures and a profile photo.",
          "cameraPermission": "SL Birdwatch uses the camera so you can photograph birds and take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SL Birdwatch records where you saw a bird when you add a sighting."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SL Birdwatch uses the microphone so you can record bird calls and songs.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#17144B"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "scheme": "slbirdwatch",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#FFFFFF",
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "translucent": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "114d5c98-76e0-40f7-832a-0dec2fdf540c"
      },
      "googleWebClientId": "186381128779-naqbo9e6vgse0rnqncfmv02997qfdh5p.apps.googleusercontent.com"
    },
    "owner": "emmanueljahveh"
  }
}
